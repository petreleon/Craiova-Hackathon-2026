<?xml version="1.0"?>
<!-- AERO-SHIELD LRCV V2.0 — Bidirectional FlightGear Protocol (60Hz OUT :5505 + 20Hz IN :5506) -->
<PropertyList>
  <generic>
    <output>
      <binary_mode>false</binary_mode>
      <line_separator>newline</line_separator>
      <var_separator>,</var_separator>

      <chunk>
        <name>lat_deg</name>
        <type>float</type>
        <format>%.7f</format>
        <node>/position/latitude-deg</node>
      </chunk>
      <chunk>
        <name>lon_deg</name>
        <type>float</type>
        <format>%.7f</format>
        <node>/position/longitude-deg</node>
      </chunk>
      <chunk>
        <name>alt_agl_m</name>
        <type>float</type>
        <format>%.2f</format>
        <node>/position/altitude-agl-ft</node>
        <factor>0.3048</factor>
      </chunk>
      <chunk>
        <name>roll_deg</name>
        <type>float</type>
        <format>%.3f</format>
        <node>/orientation/roll-deg</node>
      </chunk>
      <chunk>
        <name>pitch_deg</name>
        <type>float</type>
        <format>%.3f</format>
        <node>/orientation/pitch-deg</node>
      </chunk>
      <chunk>
        <name>heading_deg</name>
        <type>float</type>
        <format>%.3f</format>
        <node>/orientation/heading-deg</node>
      </chunk>
      <chunk>
        <name>airspeed_mps</name>
        <type>float</type>
        <format>%.2f</format>
        <node>/velocities/airspeed-kt</node>
        <factor>0.514444</factor>
      </chunk>
      <chunk>
        <name>vn_mps</name>
        <type>float</type>
        <format>%.2f</format>
        <node>/velocities/speed-north-fps</node>
        <factor>0.3048</factor>
      </chunk>
      <chunk>
        <name>ve_mps</name>
        <type>float</type>
        <format>%.2f</format>
        <node>/velocities/speed-east-fps</node>
        <factor>0.3048</factor>
      </chunk>
      <chunk>
        <name>vd_mps</name>
        <type>float</type>
        <format>%.2f</format>
        <node>/velocities/speed-down-fps</node>
        <factor>0.3048</factor>
      </chunk>
      <chunk>
        <name>p_dps</name>
        <type>float</type>
        <format>%.3f</format>
        <node>/orientation/p-body</node>
        <factor>57.29578</factor>
      </chunk>
      <chunk>
        <name>q_dps</name>
        <type>float</type>
        <format>%.3f</format>
        <node>/orientation/q-body</node>
        <factor>57.29578</factor>
      </chunk>
      <chunk>
        <name>r_dps</name>
        <type>float</type>
        <format>%.3f</format>
        <node>/orientation/r-body</node>
        <factor>57.29578</factor>
      </chunk>
      <chunk>
        <name>wind_from_deg</name>
        <type>float</type>
        <format>%.1f</format>
        <node>/environment/wind-from-heading-deg</node>
      </chunk>
      <chunk>
        <name>wind_mps</name>
        <type>float</type>
        <format>%.2f</format>
        <node>/environment/wind-speed-kt</node>
        <factor>0.514444</factor>
      </chunk>
      <chunk>
        <name>visibility_m</name>
        <type>float</type>
        <format>%.1f</format>
        <node>/environment/visibility-m</node>
      </chunk>
      <chunk>
        <name>gear_pos_norm</name>
        <type>float</type>
        <format>%.2f</format>
        <node>/gear/gear[0]/position-norm</node>
      </chunk>
      <chunk>
        <name>rwy_thr_lat_deg</name>
        <type>float</type>
        <format>%.7f</format>
        <node>/aero-shield/target-rwy/lat-deg</node>
      </chunk>
      <chunk>
        <name>rwy_thr_lon_deg</name>
        <type>float</type>
        <format>%.7f</format>
        <node>/aero-shield/target-rwy/lon-deg</node>
      </chunk>
      <chunk>
        <name>rwy_true_hdg_deg</name>
        <type>float</type>
        <format>%.4f</format>
        <node>/aero-shield/target-rwy/heading-deg</node>
      </chunk>
      <chunk>
        <name>rwy_thr_elev_m</name>
        <type>float</type>
        <format>%.2f</format>
        <node>/aero-shield/target-rwy/elev-m</node>
      </chunk>
      <chunk>
        <name>alt_msl_m</name>
        <type>float</type>
        <format>%.2f</format>
        <node>/position/altitude-ft</node>
        <factor>0.3048</factor>
      </chunk>
    </output>

    <input>
      <binary_mode>false</binary_mode>
      <line_separator>newline</line_separator>
      <var_separator>,</var_separator>

      <chunk>
        <name>active</name>
        <type>int</type>
        <node>/aero-shield/active</node>
      </chunk>
      <chunk>
        <name>distance_m</name>
        <type>float</type>
        <node>/aero-shield/distance-m</node>
      </chunk>
      <chunk>
        <name>cross_track_m</name>
        <type>float</type>
        <node>/aero-shield/cross-track-m</node>
      </chunk>
      <chunk>
        <name>alt_agl_m</name>
        <type>float</type>
        <node>/aero-shield/alt-agl-m</node>
      </chunk>
      <chunk>
        <name>heading_corr_deg</name>
        <type>float</type>
        <node>/aero-shield/heading-corr-deg</node>
      </chunk>
      <chunk>
        <name>gs_error_deg</name>
        <type>float</type>
        <node>/aero-shield/gs-error-deg</node>
      </chunk>
      <chunk>
        <name>crab_deg</name>
        <type>float</type>
        <node>/aero-shield/crab-deg</node>
      </chunk>
      <chunk>
        <name>target_heading_deg</name>
        <type>float</type>
        <node>/aero-shield/target-heading-deg</node>
      </chunk>
      <chunk>
        <name>target_pitch_deg</name>
        <type>float</type>
        <node>/aero-shield/target-pitch-deg</node>
      </chunk>
      <chunk>
        <name>flare_active</name>
        <type>int</type>
        <node>/aero-shield/flare-active</node>
      </chunk>
      <chunk>
        <name>gnss_quarantined</name>
        <type>int</type>
        <node>/aero-shield/gnss-quarantined</node>
      </chunk>
      <chunk>
        <name>autoland_cmd</name>
        <type>int</type>
        <node>/aero-shield/autoland-cmd</node>
      </chunk>
    </input>
  </generic>
</PropertyList>
